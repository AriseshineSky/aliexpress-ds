[Unit]
Description=AliExpress DS enqueue-es (urls → Redis product queue)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=Admin
Group=Admin
WorkingDirectory=/home/Admin/aliexpress-ds
Environment=HOME=/home/Admin
Environment=PATH=/home/Admin/.local/bin:/usr/local/bin:/usr/bin:/bin
# Refill Redis queue from ES urls missing in products (quality + blacklist from .env).
# --reset-queue: clear list every 2h, rebuild quality-first / reviews DESC.
# Dedupe: ES_PRODUCTS_INDEX only (not Redis seen).
# Safe to run on one VPS only (primary feeder).
ExecStart=/home/Admin/.local/bin/uv run aliexpress-ds enqueue-es --reset-queue
TimeoutStartSec=3600
Nice=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=aliexpress-ds-enqueue

NoNewPrivileges=true
PrivateTmp=true
