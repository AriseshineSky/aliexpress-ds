[Unit]
Description=AliExpress DS enqueue-es (urls → Redis product queue)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=Admin
Group=Admin
WorkingDirectory=/home/Admin/aliexpress-ds
Environment=HOME=/home/Admin
Environment=PATH=/home/Admin/.local/bin:/usr/local/bin:/usr/bin:/bin
# Refill Redis queue from ES urls missing in products (blacklist from .env).
# --reset-queue: rebuild reviews>90 DESC, unknown, then reviews<=90 DESC.
# Dedupe: ES_PRODUCTS_INDEX plus Redis seen for duplicate US/COM URL documents.
# Safe to run on one VPS only (primary feeder).
ExecStart=/home/Admin/.local/bin/uv run aliexpress-ds enqueue-es --reset-queue
TimeoutStartSec=3600
Nice=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=aliexpress-ds-enqueue

NoNewPrivileges=true
PrivateTmp=true
